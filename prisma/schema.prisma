// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  account      Account?
}

model Account {
  id                String        @id @default(uuid()) @db.Uuid
  accountNumber     String        @unique
  owner             User          @relation(fields: [ownerId], references: [id])
  ownerId           String        @unique @db.Uuid
  balanceCents      Int           @default(50000)
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  sentTransfers     Transfer[]    @relation("SentTransfers")
  receivedTransfers Transfer[]    @relation("ReceivedTransfers")
  ledgersEntries    LedgerEntry[]

  @@index([ownerId])
}

model Transfer {
  id                   String        @id @default(uuid()) @db.Uuid
  sourceAccount        Account       @relation("SentTransfers", fields: [sourceAccountId], references: [id])
  sourceAccountId      String        @db.Uuid
  amountCents          Int
  destinationAccount   Account       @relation("ReceivedTransfers", fields: [destinationAccountId], references: [id])
  destinationAccountId String        @db.Uuid
  idempotencyKey       String        @unique
  createdAt            DateTime      @default(now()) @db.Timestamptz(3)
  ledgerEntries        LedgerEntry[]

  @@index([sourceAccountId])
  @@index([destinationAccountId])
}

model LedgerEntry {
  id          String    @id @default(uuid()) @db.Uuid
  accountId   String    @db.Uuid
  account     Account   @relation(fields: [accountId], references: [id])
  transfer    Transfer? @relation(fields: [transferId], references: [id])
  transferId  String?   @db.Uuid
  amountCents Int
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@index([accountId])
}
